# Phase 1 environment variables. Copy to .env.local (git-ignored) and fill in
# real values. Do NOT commit .env.local.
#
# All values here are placeholders — populated by Phase 1 slices 3–7 as each
# vendor account is provisioned.

# --- Auth + Postgres (Supabase, per ADR-0006) -------------------------------
# Get from https://app.supabase.com/project/<ref>/settings/api after creating
# a project in the EU (Frankfurt) region.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=replace_me_project_JWT_secret_from_dashboard
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...replace_me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...replace_me
SUPABASE_WEBHOOK_SIGNING_SECRET=replace_me

# Postgres connection string — Supabase's pooled URL:
#   postgres://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.replace:replace_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Queue (Inngest) --------------------------------------------------------
# https://app.inngest.com. Signing key verifies inbound events; event key
# authenticates our outbound sends.
INNGEST_SIGNING_KEY=signkey-test-replace_me
INNGEST_EVENT_KEY=replace_me

# --- Providers --------------------------------------------------------------
# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=key_id:key_secret_replace_me
# Public host — used to build the fal webhook_url. Include scheme, no path.
PUBLIC_HOST=https://veyrnox.ai
# Replicate (Phase 3) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_replace_me
REPLICATE_WEBHOOK_SECRET=replace_me

# --- Billing (LemonSqueezy) — Phase 2 ---------------------------------------
# https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLC...replace_me
LEMONSQUEEZY_WEBHOOK_SECRET=replace_me
LEMONSQUEEZY_STORE_ID=00000

# --- Media (Cloudflare R2) — Phase 1 slice 7 --------------------------------
# Bucket is bound at the Worker layer via wrangler.jsonc; no env vars in
# production. For local development, set these to hit the R2 REST API.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=veyrnox-media

# --- Moderation (DeepSeek / GLM) — Phase 4 ----------------------------------
DEEPSEEK_API_KEY=sk-replace_me

# --- Observability (Phase 4) ------------------------------------------------
SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0
POSTHOG_KEY=phc_replace_me

# --- Legacy MuAPI cookie route (deprecated, sunset 30 days after Slice 3) ---
# No env var — the cookie carries the user's own MuAPI key. Kept for the
# transition window only.
