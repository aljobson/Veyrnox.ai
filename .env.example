# Local development. Copy to .env.local (git-ignored) and fill in values for
# your own environment. Never commit .env.local.
#
# Production and staging do not read this file. Public values and feature
# flags live in wrangler.jsonc `vars`; secrets are Worker secrets
# (`wrangler secret put NAME`) and are listed, with what reads them, at the
# end of wrangler.jsonc. Keep this file in step with that list.

# --- Supabase (ADR-0006) -----------------------------------------------------
# Public: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
# Secret: PostgREST RPCs, bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Optional: a static JWKS (JSON) instead of fetching
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json. Tokens are ES256.
SUPABASE_JWKS=

# Scripts and acceptance tests only (scripts/migrate.mjs,
# packages/db/*.acceptance.test.ts). Use a local Postgres, never production.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/veyrnox

# Origin for provider callbacks, Stripe return URLs and social OAuth redirects.
PUBLIC_HOST=http://localhost:3000

# --- Generation providers (ADR-0020, ADR-0058) -------------------------------
FAL_KEY=
FAL_WEBHOOK_USER_ID=
KIE_API_KEY=
KIE_WEBHOOK_HMAC_KEY=
OPENROUTER_API_KEY=
OPENROUTER_WEBHOOK_SECRET=
GRSAI_API_KEY=
BYTEPLUS_API_KEY=
# Classifier for provider submit refusals (lib/jev.js, ADR-0066).
TYPESAFE_API_KEY=

# --- Billing: Stripe (ADR-0031) ----------------------------------------------
# Test mode only for local work: sk_test_… and the matching whsec_….
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Media: Cloudflare R2 (SigV4, packages/adapters/r2.js) -------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 'eu' for the EU-jurisdiction bucket (ADR-0021); blank for the default.
R2_JURISDICTION=

# --- Operator endpoints --------------------------------------------------------
# Bearer tokens for /api/admin/top-up-backfill and /api/admin/reap-assets.
TOP_UP_BACKFILL_TOKEN=
ADMIN_REAP_TOKEN=

# --- Veyrnox Publish (ADR-0061); off unless PUBLISH_ENABLED=true -------------
PUBLISH_ENABLED=false
SOCIAL_OAUTH_STATE_SECRET=
# base64 of exactly 32 bytes
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_MEDIA_PROXY_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Auth id of the account whose generations become weekly brand draft posts
# (lib/social/brandDrafts.js). Unset: no drafts. Set with `wrangler secret put`.
BRAND_DRAFTS_AUTH_ID=

# --- Violation notices by email (Resend, issue #479); off unless both are set
# Worker secret. Set with `wrangler secret put`.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. Veyrnox <support@veyrnox.ai>
VIOLATION_EMAIL_FROM=

# --- Cinema: Cloudflare Stream (ADR-0052…0057); off unless the CINEMA_* flags
# in wrangler.jsonc are "true" --------------------------------------------------
CINEMA_STREAM_ACCOUNT_ID=
CINEMA_STREAM_API_TOKEN=
CINEMA_STREAM_WEBHOOK_SECRET=
CINEMA_STREAM_SIGNING_KEY_ID=
# base64 of the RSA private JWK
CINEMA_STREAM_SIGNING_JWK=
CINEMA_STREAM_CUSTOMER_CODE=
