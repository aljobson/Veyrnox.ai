# Policy gates and their inputs need an owner review; a PR must not be able
# to edit the gate it is being checked by. Pair with branch protection
# "Require review from Code Owners" on main.
/scripts/               @aljobson
/.github/               @aljobson
/.gitmodules            @aljobson
/middleware.js          @aljobson
/next.config.mjs        @aljobson
/wrangler.jsonc         @aljobson
/packages/db/schema/    @aljobson
/app/api/webhook/       @aljobson
# Hooks under .claude/ run on the owner's machine each session; a lockfile
# swap runs install scripts in the deploy job.
/.claude/               @aljobson
/package.json           @aljobson
/package-lock.json      @aljobson
