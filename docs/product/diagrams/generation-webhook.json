  "cards": [
    {
      "dot": "amber",
      "title": "Credits move before the provider does",
      "items": [
        "ledger_debit creates the jobs row and the ledger entry in one transaction",
        "A replayed idempotency key returns the first result instead of debiting twice",
        "A free-allowance job is created at 0 Credits with no ledger row"
      ]
    },
    {
      "dot": "cyan",
      "title": "Nothing in the callback is trusted",
      "items": [
        "Raw bytes are read before Next can parse them",
        "kie signs only taskId and timestamp, so the task is re-read from kie",
        "The job is found by provider_job_id, never by a user_id in the payload"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure owes the user their credits",
      "items": [
        "A rejected submit refunds before the response returns",
        "job_failed is always paired with ledger_refund",
        "pg_cron refunds anything stuck: 15 min debited, 120 min submitted"
      ]
    }
  ]
}