{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Generation job lifecycle (jobs.state)",
    "output": "job-lifecycle.html",
    "viewBox": [
      1030,
      630
    ],
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Happy path"
    },
    {
      "id": "retry",
      "label": "Bounded retry"
    },
    {
      "id": "terminal",
      "label": "Failure and refund"
    }
  ],
  "states": [
    {
      "id": "debited",
      "type": "start",
      "label": "DEBITED",
      "sublabel": "ledger_debit + jobs row",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "credits held"
    },
    {
      "id": "submitted",
      "type": "active",
      "label": "SUBMITTED",
      "sublabel": "provider accepted",
      "lane": "main",
      "col": 2,
      "step": "02",
      "tag": "webhook or poll"
    },
    {
      "id": "succeeded",
      "type": "active",
      "label": "SUCCEEDED",
      "sublabel": "provider output ready",
      "lane": "main",
      "col": 3,
      "step": "03",
      "tag": "copy to R2"
    },
    {
      "id": "stored",
      "type": "success",
      "label": "STORED",
      "sublabel": "R2 object + SHA-256",
      "lane": "main",
      "col": 4,
      "step": "04",
      "tag": "terminal"
    },
    {
      "id": "failover",
      "type": "failure",
      "label": "FAILOVER",
      "sublabel": "429 / transient",
      "lane": "retry",
      "col": 0,
      "tag": "ADR-0009"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "FAILED",
      "sublabel": "provider or store failed",
      "lane": "terminal",
      "col": 1,
      "tag": "sweep"
    },
    {
      "id": "refunded",
      "type": "neutral",
      "label": "REFUNDED",
      "sublabel": "ledger_refund, exact debit",
      "lane": "terminal",
      "col": 2,
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "to-failover",
      "from": "submitted",
      "to": "failover",
      "label": "429",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelAt": [
        360,
        233
      ]
    },
    {
      "id": "failover-back",
      "from": "failover",
      "to": "submitted",
      "label": "resubmit",
      "variant": "emphasis",
      "labelAt": [
        470,
        233
      ]
    },
    {
      "id": "provider-failed",
      "from": "succeeded",
      "to": "failed",
      "label": "store failed",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelAt": [
        556,
        320
      ]
    },
    {
      "id": "failed-refund",
      "from": "failed",
      "to": "refunded",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "Debit and jobs row commit in one transaction",
        "fal, kie, OpenRouter complete by signed webhook",
        "GrsAI and BytePlus complete by the 5-minute poll"
      ]
    },
    {
      "dot": "rose",
      "title": "Every failure refunds",
      "items": [
        "Submit refusal, provider failure or store failure end in REFUNDED",
        "The refund is the exact debit, Free Credits back to Free",
        "Stuck jobs are swept by pg_cron"
      ]
    }
  ]
}