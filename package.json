{
  "name": "open-generative-ai",
  "description": "Open-source alternative to HF AI \u2014 AI image, video, cinema and lip sync studio",
  "homepage": "https://github.com/Anil-matcha/Open-Generative-AI",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents",
    "packages/Open-AI-Design-Agent/packages/design-agent",
    "packages/db",
    "packages/adapters",
    "packages/catalog"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:packages && next build",
    "start": "next start",
    "lint": "next lint",
    "build:studio": "npm run build -w studio",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:design-agent": "npm run build -w design-agent",
    "build:packages": "npm run build:workflow && npm run build:agent && npm run build:design-agent && npm run build:studio",
    "setup": "git submodule update --init --recursive && npm install && npm run build:packages",
    "build:worker": "npm run build && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents",
    "axios": "^1.7.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "file:./packages/studio",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.2",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "prismjs": "^1.30.0"
  }
}
