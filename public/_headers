# Served by the Workers Assets binding, which bypasses next.config headers().
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin

# Next fingerprints these files. The Workers Assets binding serves them
# directly, so next.config headers() never gets a chance to set this policy.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Template showcase clips and posters (about 650 MB). Their names are not fingerprinted and a file can be
# replaced in place, so this is not immutable: a day of browser cache, then a stale copy may be served for up
# to a week while the browser revalidates in the background. Without this they revalidated on every view.
/showcase/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pinned model/runtime inventory: bump this path when any shipped byte changes.
/video-enhance/mediapipe-1.0.1-face-landmarker-1/*
  Cache-Control: public, max-age=31536000, immutable

/video-enhance/mediapipe-1.0.1-face-landmarker-1/face_landmarker.task
  Content-Type: application/octet-stream

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
