# Served by the Workers Assets binding, which bypasses next.config headers().
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin

# Next fingerprints these files. The Workers Assets binding serves them
# directly, so next.config headers() never gets a chance to set this policy.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Pinned model/runtime inventory: bump this path when any shipped byte changes.
/video-enhance/mediapipe-1.0.1-face-landmarker-1/*
  Cache-Control: public, max-age=31536000, immutable

/video-enhance/mediapipe-1.0.1-face-landmarker-1/face_landmarker.task
  Content-Type: application/octet-stream
