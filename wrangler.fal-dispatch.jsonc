{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veyrnox-fal-dispatch",
  "account_id": "fb18d9f7052afbea5a5e0eae69948af2",
  "main": "workers/fal-dispatch-worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // Production has no queue binding. Staging resources are isolated.
  // Secrets: SUPABASE_SERVICE_ROLE_KEY, FAL_KEY. No browser or R2 credentials.
  "vars": {
    "FAL_DISPATCH_SCHEMA_ENABLED": "false",
    "FAL_DISPATCH_QUEUE_CONSUMER_ENABLED": "false",
    "FAL_DISPATCH_QUEUE_NAME": "veyrnox-fal-dispatch",
    "SUPABASE_URL": "https://xdxdzmsztyzbnzeforxx.supabase.co",
    "PUBLIC_HOST": "https://veyrnox.ai"
  },
  "env": {
    "staging": {
      "name": "veyrnox-fal-dispatch-staging",
      "queues": { "consumers": [{
        "queue": "veyrnox-fal-dispatch-staging",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "retry_delay": 30,
        "max_concurrency": 2,
        "dead_letter_queue": "veyrnox-fal-dispatch-staging-dlq"
      }] },
      "vars": {
        "FAL_DISPATCH_SCHEMA_ENABLED": "true",
        "FAL_DISPATCH_QUEUE_CONSUMER_ENABLED": "false",
        "FAL_DISPATCH_QUEUE_NAME": "veyrnox-fal-dispatch-staging",
        "SUPABASE_URL": "https://yrqzwqywxfesmbvhzjgj.supabase.co",
        "PUBLIC_HOST": "https://veyrnox-ai-staging.al-jobson.workers.dev"
      }
    }
  }
}
