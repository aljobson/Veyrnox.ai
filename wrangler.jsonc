{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veyrnox-ai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public config — safe to commit. SUPABASE_URL used by middleware.js;
  // NEXT_PUBLIC_* by client bundle.
  "vars": {
    "SUPABASE_URL": "https://yrqzwqywxfesmbvhzjgj.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://yrqzwqywxfesmbvhzjgj.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_bAxQiodzBhI6bV7lmo9gMQ_Hlg9_Ish"
  },
  // ------------------------------------------------------------------
  // Phase 1 binding placeholders. All commented until each Slice's
  // vendor account exists. Uncomment as each slice lands.
  // ------------------------------------------------------------------
  // Slice 7 — R2 for generated media
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "veyrnox-media" }
  // ],
  //
  // Slice 4 — Neon DATABASE_URL is a secret, set via `wrangler secret put
  // DATABASE_URL`, not committed. Do not add it here.
  //
  // Optional Hyperdrive overlay in front of Neon (Slice 4+)
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "REPLACE_ME_AFTER_CREATING" }
  // ],
  //
  // Slice 6 — Inngest signing key: `wrangler secret put INNGEST_SIGNING_KEY`
  //
  // Slice 3 — Clerk secrets: `wrangler secret put CLERK_SECRET_KEY`, etc.
  //
  // Slice 5 — fal.ai key: `wrangler secret put FAL_KEY`
  //
  // Phase 2 — LemonSqueezy secrets: `wrangler secret put LEMONSQUEEZY_API_KEY`
}
