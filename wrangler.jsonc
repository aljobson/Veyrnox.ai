{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veyrnox-ai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public config — safe to commit. SUPABASE_URL used by middleware.js;
  // NEXT_PUBLIC_* by client bundle.
  "vars": {
    "SUPABASE_URL": "https://xdxdzmsztyzbnzeforxx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://xdxdzmsztyzbnzeforxx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_HwEQqi6FXJOmWpy5eqR9-A_Zvy8_ii1"
  },
  // ------------------------------------------------------------------
  // Secrets (never here — `wrangler secret put <NAME>`), per ADR-0004
  // (Supabase auth + Postgres) and the shipped Phase 1 slices:
  //   SUPABASE_SERVICE_ROLE_KEY   PostgREST RPCs, bypasses RLS (packages/db/supabase-client.js)
  //   FAL_KEY                     fal.ai queue submit (packages/adapters/fal.js)
  //   FAL_WEBHOOK_USER_ID         our fal tenant id; webhook callbacks for any other are rejected
  //   PUBLIC_HOST                 https origin fal calls back on (/api/webhook/fal)
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
  //                               SigV4 R2 client (packages/adapters/r2.js)
  //   ADMIN_REAP_TOKEN            /api/admin/reap-assets shared secret (ADR-0008)
  //   UPLOAD_PROXY_ALLOWED_HOSTS  legacy upload proxy allowlist (docs/UPLOAD_PROXY_CONFIG.md)
  //
  // No R2 binding: r2.js signs plain fetch against the S3 endpoint so the
  // Worker never needs `env.MEDIA` / getCloudflareContext() in middleware.
}
