{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veyrnox-ai",
  // worker.js wraps the generated .open-next/worker.js to add the Cron Trigger.
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep Worker logs (console.error on provider rejects, webhook signature
  // failures) in the dashboard instead of needing a live `wrangler tail`.
  "observability": { "enabled": true },
  // ADR-0039: approximate per-IP/per-location screening before admin routes.
  "ratelimits": [{
    "name": "ADMIN_EDGE_RATE_LIMITER",
    "namespace_id": "2026092401",
    "simple": { "limit": 60, "period": 60 }
  }],
  // Top-up backfill (#94): GitHub Actions schedules proved unreliable, so the
  // Worker runs POST /api/admin/top-up-backfill itself (worker.js).
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public config — safe to commit. SUPABASE_URL used by middleware.js;
  // NEXT_PUBLIC_* by client bundle.
  "vars": {
    // ADR-0040: enable only after migration 0123 is applied and verified.
    "TOP_UP_READ_RATE_LIMIT_ENABLED": "false",
    // Migration 0120 applied 2026-09-24; ADR-0038 records activation checks.
    "TOP_UP_CHECKOUT_RATE_LIMIT_ENABLED": "true",
    // Migration 0117 applied 2026-09-24; ADR-0036 records activation checks.
    "ACCOUNT_READ_RATE_LIMIT_ENABLED": "true",
    // Migration 0116 applied 2026-09-24; ADR-0035 records activation checks.
    "UPLOAD_REQUEST_RATE_LIMIT_ENABLED": "true",
    // Migration 0110 applied 2026-09-24; ADR-0008 records activation checks.
    "ASSET_LINK_RATE_LIMIT_ENABLED": "true",
    "SUPABASE_URL": "https://xdxdzmsztyzbnzeforxx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://xdxdzmsztyzbnzeforxx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_HwEQqi6FXJOmWpy5eqR9-A_Zvy8_ii1",
    // LemonSqueezy store (#91). Test and live mode share the store id; the
    // API key decides the mode. Variant ids live in public.credit_packs.
    "LEMONSQUEEZY_STORE_ID": "473468",
    // Which orders the webhook credits (#93). "true" while the store and API
    // key are test mode; flip to "false" with the live key at launch (#101).
    // Anything else and /api/webhook/lemonsqueezy answers 503.
    "LEMONSQUEEZY_TEST_MODE": "true",
    // Stripe Tax (ADR-0031, amendment 2026-09-23). Managed Payments is enabled
    // on both accounts, so Stripe is the Merchant of Record and charges and
    // remits the tax. Automatic tax is ON; unset means ON. Setting this to
    // the exact string "false" is the only way off, and Stripe refuses such a
    // session with a 400 while Managed Payments is enabled — which is how
    // POST /api/v1/top-ups returned 502 checkout_failed on 2026-09-23.
    // "STRIPE_AUTOMATIC_TAX": "false",
    // "true" makes /api/v1/admin/metrics refuse any session that has not
    // satisfied a second factor (Supabase `aal` claim must be "aal2").
    // Switched on 2026-09-24: the owner enrolled TOTP at /app/admin first and
    // the panel confirmed "Enabled. This session is aal2." Turning it on
    // before an admin holds a factor locks every admin out of their own
    // dashboard, so that order is not optional.
    "ADMIN_REQUIRE_AAL2": "true",
    // Cloudflare Access covers veyrnox.ai/app/admin*, /api/v1/admin/* and
    // /api/admin/* (one application, "Veyrnox.ai admin"). These two let the
    // Worker verify the assertion itself (lib/accessJwt.js) instead of
    // trusting the edge: a policy loosened in the dashboard does not silently
    // open the machine endpoints. Public values — the team domain is in every
    // Access redirect and the AUD identifies the application, neither
    // authenticates anything.
    "ACCESS_TEAM_DOMAIN": "fancy-lake-7c60.cloudflareaccess.com",
    "ACCESS_AUD": "4bea77db854633f7b4546a485bcb14c1e0c4389318ebd565e9a326edf17d0163"
  },
  // ------------------------------------------------------------------
  // Secrets (never here — `wrangler secret put <NAME>`), per ADR-0004
  // (Supabase auth + Postgres) and the shipped Phase 1 slices:
  //   SUPABASE_SERVICE_ROLE_KEY   PostgREST RPCs, bypasses RLS (packages/db/supabase-client.js)
  //   FAL_KEY                     fal.ai queue submit (packages/adapters/fal.js)
  //   FAL_WEBHOOK_USER_ID         our fal tenant id; webhook callbacks for any other are rejected
  //   PUBLIC_HOST                 https origin fal calls back on (/api/webhook/fal)
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
  //                               SigV4 R2 client (packages/adapters/r2.js)
  //   R2_JURISDICTION             'eu' once media is cut over to the EU-jurisdiction bucket (ADR-0021)
  //   GRSAI_API_KEY               GrsAI submit + authenticated scheduled polling (ADR-0020)
  //   KIE_API_KEY, KIE_WEBHOOK_HMAC_KEY
  //                               kie.ai submit + callback HMAC (ADR-0020)
  //   OPENROUTER_API_KEY, OPENROUTER_WEBHOOK_SECRET
  //                               OpenRouter video submit + webhook signature (ADR-0020)
  //   STRIPE_SECRET_KEY           Checkout Session create + session re-fetch (packages/adapters/stripe.js);
  //                               sk_test_… until the live account clears review (ADR-0031). Its prefix
  //                               is what decides which livemode the webhook will credit.
  //   STRIPE_WEBHOOK_SECRET       whsec_… signs /api/webhook/stripe AND the Top-up id in session metadata (#93)
  //   LEMONSQUEEZY_API_KEY        retired by ADR-0031; the routes stay in the tree, unused
  //   LEMONSQUEEZY_WEBHOOK_SECRET retired by ADR-0031; see above
  //   TOP_UP_BACKFILL_TOKEN       bearer for /api/admin/top-up-backfill (#94); same value in the TOP_UP_BACKFILL_TOKEN Actions secret
  //   ADMIN_REAP_TOKEN            /api/admin/reap-assets shared secret (ADR-0008)
  //   UPLOAD_PROXY_ALLOWED_HOSTS  legacy upload proxy allowlist (docs/UPLOAD_PROXY_CONFIG.md)
  //
  // No R2 binding: r2.js signs plain fetch against the S3 endpoint so the
  // Worker never needs `env.MEDIA` / getCloudflareContext() in middleware.
}
